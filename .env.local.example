# ─────────────────────────────────────────────
#  Spheres Systems · variables de entorno
#  Copia este archivo a .env.local y completa los valores.
# ─────────────────────────────────────────────

# URL pública del sitio (úsala también en Vercel)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Cliente (seguro exponer al browser)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — Servidor (NUNCA exponer al cliente; solo usado en /api/leads)
SUPABASE_SERVICE_ROLE_KEY=
